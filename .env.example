DSH_PROVIDER=deepseek-official
DSH_MODEL=glm-5.3
DSH_BASE_URL=http://llm.moontontech.net
DSH_API_KEY=
DSH_HOME=.dsh-base-agent/dsh-home
# API authentication is disabled by default for local development. When disabled,
# callers keep using X-Tenant-ID and X-Principal-ID.
DSH_BASE_AGENT_AUTH_ENABLED=false
# When enabled, the API accepts X-MOA-Token and derives identity from MOA checktoken.
# DSH_BASE_AGENT_AUTH_TENANT_ID=moonton
# DSH_BASE_AGENT_MOA_AUTH_URL=https://login.moa.moonton.net
# DSH_BASE_AGENT_MOA_PROJECT_ID=replace-with-the-approved-project-id
# DSH_BASE_AGENT_MOA_CONNECT_TIMEOUT_SECONDS=0.5
# DSH_BASE_AGENT_MOA_REQUEST_TIMEOUT_SECONDS=1
# DSH_BASE_AGENT_MOA_MAX_IN_FLIGHT=32
# Leave unset for local SQLite. Set for PostgreSQL control-plane persistence:
# DSH_BASE_AGENT_DATABASE_URL=postgresql://agent:secret@localhost:5432/dsh_base_agent
# DSH_BASE_AGENT_DATABASE_SCHEMA=dsh_base_agent
# DSH_BASE_AGENT_DATABASE_POOL_MIN_SIZE=1
# DSH_BASE_AGENT_DATABASE_POOL_MAX_SIZE=10
# Set to 0 when required by PgBouncer transaction/statement pooling:
# DSH_BASE_AGENT_DATABASE_STATEMENT_CACHE_SIZE=100
# Tool 大结果正文默认保存在 <workspace>/.dsh-base-agent/artifacts：
# DSH_BASE_AGENT_ARTIFACT_BACKEND=local
# API/Worker 分离时应配置为所有 Pod 共享的 PVC 路径：
# DSH_BASE_AGENT_ARTIFACT_LOCAL_ROOT=/shared-pvc/dsh-base-agent/artifacts
# DSH_BASE_AGENT_ARTIFACT_MAX_OBJECT_BYTES=67108864
# Optional best-effort direct DSH notification stream (no PostgreSQL outbox):
# DSH_BASE_AGENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# DSH_BASE_AGENT_KAFKA_TOPIC=dsh.notifications.v1
# DSH_BASE_AGENT_KAFKA_CLIENT_ID=dsh-base-agent
# DSH_BASE_AGENT_KAFKA_QUEUE_CAPACITY=4096
# DSH_BASE_AGENT_KAFKA_REQUEST_TIMEOUT_MS=30000
# DSH_BASE_AGENT_KAFKA_CLOSE_TIMEOUT_SECONDS=10
# DSH_BASE_AGENT_KAFKA_MAX_MESSAGE_BYTES=900000
# DSH_BASE_AGENT_KAFKA_REQUIRED=false
# Independent PostgreSQL Worker tuning:
# DSH_BASE_AGENT_WORKER_ID=worker-local-1
# DSH_BASE_AGENT_WORKER_POLL_INTERVAL_SECONDS=0.5
# DSH_BASE_AGENT_WORKER_LEASE_SECONDS=30
# DSH_BASE_AGENT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# DSH_BASE_AGENT_WORKER_MAX_CONCURRENCY=4
# DSH_BASE_AGENT_WORKER_MAX_OWNED_CONVERSATIONS=128
# DSH_BASE_AGENT_WORKER_SHUTDOWN_TIMEOUT_SECONDS=15
# Optional runtime tuning:
# DSH_MAX_TOKENS=4096
# DSH_REQUEST_TIMEOUT_SECONDS=300
# DSH_INITIALIZE_TIMEOUT_SECONDS=30
# DSH_SHUTDOWN_TIMEOUT_SECONDS=5
# DSH_BIN=/absolute/path/to/dsh
